# Production env for backend (copy to .env on the server. Never commit real secrets).
NODE_ENV=production
PORT=4000
DB_PATH=/data/app.db
UPLOAD_DIR=/data/uploads
CORS_ORIGIN=https://www.industrial.talentooo.com,https://industrial.talentooo.com
JSON_LIMIT=2mb
RATE_WINDOW_MS=60000
RATE_MAX=300
TRUST_PROXY=1
SEED_ON_BOOT=0
ALLOW_DEMO_AUTH=0
JWT_SECRET=change-me-to-96-hex-chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
BCRYPT_ROUNDS=10
SERVE_FRONTEND=0
# Message center — Gmail reminders (SMTP + App Password). Never commit the real password.
GMAIL_USER=your-sender-account@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=المنصة الوطنية للتمويل والمبادرات الصناعية
APP_URL=https://www.industrial.talentooo.com
CHAT_REMINDER_DELAY_MIN=15
CHAT_REMINDER_SWEEP_SEC=60
CHAT_MAX_FILE_MB=20
