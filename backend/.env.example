# انسخ الى .env قبل التشغيل — PROD: لا تستخدم * ابدا + JWT_SECRET اجباري
NODE_ENV=development
PORT=4000
# ── قاعدة البيانات ─────────────────────────────────────────────────────
# sqlite (افتراضي، ملف محلي — صفر إعداد) أو mysql (سيرفر مشترك/إنتاج).
DB_DRIVER=sqlite
DB_PATH=./data/app.db
# فعّل MySQL فقط عند الحاجة — يتطلب MySQL >= 8.0.16 وقاعدة بترميز utf8mb4.
# أنشئ القاعدة والمستخدم أولاً (انظر docs/MYSQL_MIGRATION.md)، ثم:
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=industry_app
# MYSQL_PASSWORD=ضع-كلمة-سر-قوية-هنا
# MYSQL_DATABASE=industry_platform
# MYSQL_POOL_SIZE=10
UPLOAD_DIR=./data/uploads
# Dev: localhost فقط. Prod: ضع الدومينات الصريحة (مثال: https://industry.gov.eg,https://www.industry.gov.eg)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
JSON_LIMIT=2mb
RATE_WINDOW_MS=60000
RATE_MAX=300
TRUST_PROXY=0
# Seed تلقائي عند الاقلاع (1=yes, 0=no). في prod الافتراضي 0 — فعله يدويا اول مرة فقط.
SEED_ON_BOOT=1
# Demo auth (x-user-id + switch-user) — مسموح في dev، محظور في prod الا بتصريح.
ALLOW_DEMO_AUTH=1
# JWT — ولد قيمة عشوائية قوية: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# في prod اجباري ويرفض الاقلاع بالقيمة الافتراضية.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
BCRYPT_ROUNDS=10

# ── مركز المراسلات: تذكير Gmail (SMTP + App Password) ─────────────────────────
# App Password: فعّل التحقق بخطوتين ثم https://myaccount.google.com/apppasswords (16 حرف)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=المنصة الوطنية للتمويل والمبادرات الصناعية
# خارج الإنتاج: كل التذكيرات تذهب لهذا البريد فقط (البذرة فيها عناوين حكومية حقيقية الشكل).
# فارغ = تسجيل في اللوغ فقط. MAIL_SEND_REAL=1 يرسل للمستلمين الحقيقيين حتى في dev.
MAIL_REDIRECT_TO=
MAIL_SEND_REAL=0
# رابط الواجهة داخل البريد (زر «فتح مركز المراسلات» → APP_URL/#chat)
APP_URL=http://localhost:3000
# التذكير بعد كم دقيقة من بقاء الرسالة غير مقروءة + دورية الفحص بالثواني
CHAT_REMINDER_DELAY_MIN=15
CHAT_REMINDER_SWEEP_SEC=60
# الحد الأقصى لحجم مرفق الشات (ميجا) — 5 ملفات كحد أقصى في الرسالة
CHAT_MAX_FILE_MB=20
