{
  "name": "industry-platform-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "start": "node dist/index.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:ping": "tsx scripts/db-ping.ts",
    "db:mysql:init": "tsx scripts/mysql-init.ts",
    "db:mysql:migrate": "tsx scripts/migrate-sqlite-to-mysql.ts",
    "db:backup": "tsx scripts/backup-sqlite.ts",
    "seed:file": "tsx scripts/seed-from-file.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:ci": "npm run build && npm test",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:prod": "node scripts/check-prod.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^7.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.7.3"
  }
}
