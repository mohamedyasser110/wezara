# Reverse proxy sample for single-VPS hosting (root of repo).
# 1) Point DNS: industry.gov.eg + www -> VPS, api.industry.gov.eg -> VPS
# 2) Issue certs once: certbot certonly --webroot -w ./certbot-www -d industry.gov.eg -d api.industry.gov.eg
# 3) Mounts below expect: /etc/letsencrypt/live/<domain>/fullchain.pem + privkey.pem
# HTTP always redirects to HTTPS. Upload cap 105m (multer ceiling 100m + margin).

upstream api_up { server api:4000; }
upstream web_up { server frontend:80; }

server {
  listen 80;
  server_name industry.gov.eg www.industry.gov.eg api.industry.gov.eg;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name api.industry.gov.eg;
  ssl_certificate /etc/letsencrypt/live/api.industry.gov.eg/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/api.industry.gov.eg/privkey.pem;
  client_max_body_size 105m;
  server_tokens off;
  gzip on;
  gzip_vary on;
  gzip_types application/json;
  # Security headers (api)
  add_header X-Frame-Options "DENY" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  location / {
    proxy_pass http://api_up;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name industry.gov.eg www.industry.gov.eg;
  ssl_certificate /etc/letsencrypt/live/industry.gov.eg/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/industry.gov.eg/privkey.pem;
  server_tokens off;
  gzip on;
  gzip_vary on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "no-referrer" always;
  location /api/ {
    proxy_pass http://api_up;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 105m;
    proxy_read_timeout 60s;
  }
  location / {
    proxy_pass http://web_up;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
