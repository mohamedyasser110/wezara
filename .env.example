# Root env for docker compose (copy to .env, never commit secrets).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Public web origin(s) — must match frontend domain. No '*' in prod.
CORS_ORIGIN=https://www.industrial.talentooo.com,https://industrial.talentooo.com

# Strong random secret (required — boot refuses default in prod).
JWT_SECRET=change-me-to-96-hex-chars

# First boot on empty DB only: 1 = seed demo orgs/users/initiatives, then set back to 0.
SEED_ON_BOOT=0

# ── Database driver: sqlite (default, embedded file) or mysql (shared server) ──
# sqlite = zero-config (DB_PATH volume). mysql = shared/production server (≥ 8.0.16,
# database created with utf8mb4 — see docs/MYSQL_MIGRATION.md). Secrets stay in .env
# (never committed); only commented placeholders live here.
DB_DRIVER=sqlite
# DB_DRIVER=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=industry_app
# MYSQL_PASSWORD=
# MYSQL_DATABASE=industry_platform
# MYSQL_POOL_SIZE=10

# Backend API base baked into frontend bundle at build time.
VITE_API_URL=https://www.industrial.talentooo.com

# Message center — Gmail reminder emails (SMTP + App Password, see docs/DEPLOY.md §5-ج).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Public frontend URL used in reminder emails (button → APP_URL/#chat).
APP_URL=https://www.industrial.talentooo.com
