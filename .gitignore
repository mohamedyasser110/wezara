# Root .gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.local

# Environment files (sensitive)
.env
.env.*
!.env.example
!.env.production.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Database
*.db
*.sqlite
*.sqlite3

# Backups
backups/
*.backup

# Uploads
uploads/

# Certificates
certs/
*.pem
*.key
*.crt

# Turbo
.turbo/

# Vercel
.vercel/

# TypeScript cache
*.tsbuildinfo